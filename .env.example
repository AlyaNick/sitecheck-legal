# ─────────────────────────────────────────────────────────────────────────────
#  Конфигурация сайта. Файл лежит в репозитории и задаёт значения по умолчанию.
#
#  Слои, снизу вверх (каждый следующий перекрывает предыдущий):
#     .env.example   ← этот файл: публичные данные, коммитится
#     .env           ← ваши правки и ВСЕ пароли, в .gitignore
#     .env.local     ← временные локальные переопределения, в .gitignore
#     переменные окружения процесса (SITE_URL=… npm run build)
#
#  Пустое значение в верхнем слое НЕ затирает заданное в нижнем — чтобы
#  забытая пустая строка в .env молча не выключала настройку.
#
#  Ключи VITE_ORG_* публичные: они попадают в бандл и в правовые документы.
#  Ключи без префикса остаются на сервере. После правки — npm run build.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Реквизиты организации ───────────────────────────────────────────────────
# Отсюда берутся подвал, Политика и Согласие (152-ФЗ).
# ЗАПОЛНИТЕ РЕАЛЬНЫМИ ДАННЫМИ. Пока значение пусто, в документе на его месте
# остаётся видимый плейсхолдер вида %VITE_ORG_INN% — это сделано намеренно:
# заметная дырка в тексте лучше, чем документ, тихо ссылающийся в пустоту.
VITE_ORG_BRAND=SiteCheck Legal
VITE_ORG_NAME_SHORT=ООО Юридическая Компания «ГИС»
VITE_ORG_NAME_FULL=Общество с ограниченной ответственностью Юридическая Компания «Глазунов и Семенов»
VITE_ORG_INN=7606095236
VITE_ORG_KPP=760401001
VITE_ORG_OGRN=1147606004809
VITE_ORG_OKVED=
VITE_ORG_ADDRESS=150040, Ярославская область, г. Ярославль, ул. Победы, д. 38/27, офис 604, пом. 1
VITE_ORG_EMAIL=company.gis@yandex.ru
VITE_ORG_PHONE=
VITE_ORG_DIRECTOR=
VITE_ORG_TELEGRAM=https://t.me/pravosoznanie_biz

# ─── Адрес сайта ─────────────────────────────────────────────────────────────
# Без слеша на конце. Правовые документы берут адрес из location.origin,
# поэтому здесь он нужен только для абсолютных ссылок при сборке.
SITE_URL=https://sitecheck-legal.ru

# ─── Почта: заявки с формы (только сервер, в бандл не попадает) ─────────────
# Ящик, КУДА приходят заявки. Он же логин SMTP и адрес отправителя, поэтому
# это должен быть реальный ящик у того провайдера, чей SMTP указан ниже.
OPERATOR_EMAIL=company.gis@yandex.ru

# Пароль приложения для этого ящика — НЕ пароль от аккаунта:
#   Яндекс:  id.yandex.ru → Безопасность → Пароли приложений → «Почта».
#   Mail.ru: Настройки → Безопасность → Пароли для внешних приложений.
# В репозитории значение всегда пустое: настоящий пароль вписывается в .env.
YANDEX_APP_PASSWORD=

# SMTP того провайдера, где заведён ящик выше. Порт 465 — SSL.
#   Яндекс:  smtp.yandex.ru      Mail.ru: smtp.mail.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
